rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function friendshipDoc(a, b) {
      return /databases/$(database)/documents/friendships/$(a + '__' + b);
    }

    // Supporta anche le amicizie legacy con ID documento non deterministico.
    // L'ID viene accettato solo se il documento conferma entrambi i partecipanti
    // e lo stato accepted: conoscere un ID da solo non concede accesso.
    function acceptedFriendshipById(friendshipId, requesterId, addresseeId) {
      let ref = /databases/$(database)/documents/friendships/$(friendshipId);
      return friendshipId is string
        && exists(ref)
        && get(ref).data.status == 'accepted'
        && get(ref).data.requesterId == requesterId
        && get(ref).data.addresseeId == addresseeId;
    }

    function hasAcceptedFriendship(userId) {
      let outgoing = friendshipDoc(request.auth.uid, userId);
      let incoming = friendshipDoc(userId, request.auth.uid);
      let targetProfile = /databases/$(database)/documents/users/$(userId);
      let currentProfile = /databases/$(database)/documents/users/$(request.auth.uid);
      return (
        (exists(outgoing) && get(outgoing).data.status == 'accepted')
        ||
        (exists(incoming) && get(incoming).data.status == 'accepted')
        ||
        (
          exists(targetProfile)
          && get(targetProfile).data.friends is list
          && get(targetProfile).data.friends.hasAny([request.auth.uid])
        )
        ||
        (
          exists(currentProfile)
          && get(currentProfile).data.friends is list
          && get(currentProfile).data.friends.hasAny([userId])
        )
        ||
        (
          exists(targetProfile)
          && get(targetProfile).data.keys().hasAny(['lastAcceptedFriendshipId'])
          && acceptedFriendshipById(
            get(targetProfile).data.lastAcceptedFriendshipId,
            userId,
            request.auth.uid
          )
        )
        ||
        (
          exists(currentProfile)
          && get(currentProfile).data.keys().hasAny(['lastAcceptedFriendshipId'])
          && acceptedFriendshipById(
            get(currentProfile).data.lastAcceptedFriendshipId,
            request.auth.uid,
            userId
          )
        )
      );
    }

    function canRemoveFriendReference(profileUserId) {
      let oldFriends = resource.data.friends;
      let newFriends = request.resource.data.friends;
      return signedIn()
        && oldFriends is list
        && newFriends is list
        && newFriends.size() == oldFriends.size() - 1
        && oldFriends.hasAll(newFriends)
        && (
          (
            profileUserId == request.auth.uid
          )
          ||
          (
            profileUserId != request.auth.uid
            && oldFriends.hasAny([request.auth.uid])
            && !newFriends.hasAny([request.auth.uid])
            && (
              (
                exists(friendshipDoc(request.auth.uid, profileUserId))
                && get(friendshipDoc(request.auth.uid, profileUserId)).data.status == 'accepted'
                && !existsAfter(friendshipDoc(request.auth.uid, profileUserId))
              )
              ||
              (
                exists(friendshipDoc(profileUserId, request.auth.uid))
                && get(friendshipDoc(profileUserId, request.auth.uid)).data.status == 'accepted'
                && !existsAfter(friendshipDoc(profileUserId, request.auth.uid))
              )
            )
          )
        );
    }

    function canReadUser(userId) {
      return signedIn() && (
        request.auth.uid == userId ||
        hasAcceptedFriendship(userId)
      );
    }

    function validFriendCode(code) {
      return code is string && code.matches('^[0-9]{6}$');
    }

    match /users/{userId} {
      allow get: if canReadUser(userId);
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && validFriendCode(request.resource.data.friendCode)
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == userId;

      allow update: if signedIn()
        && (
          (
            request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['friends'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['friendCode'])
              || getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == userId
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
            && canRemoveFriendReference(userId)
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'lastAcceptedFriendshipId'])
            && request.resource.data.friends is list
            && request.resource.data.lastAcceptedFriendshipId is string
            && (
              (
                resource.data.friends is list
                && request.resource.data.friends.hasAll(resource.data.friends)
                && request.resource.data.friends.size() == resource.data.friends.size() + 1
                && request.resource.data.friends.hasAny([request.auth.uid])
                && !resource.data.friends.hasAny([request.auth.uid])
              )
              ||
              (
                !resource.data.keys().hasAny(['friends'])
                && request.resource.data.friends == [request.auth.uid]
              )
            )
            && getAfter(/databases/$(database)/documents/friendships/$(request.resource.data.lastAcceptedFriendshipId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/friendships/$(request.resource.data.lastAcceptedFriendshipId)).data.requesterId == userId
            && getAfter(/databases/$(database)/documents/friendships/$(request.resource.data.lastAcceptedFriendshipId)).data.addresseeId == request.auth.uid
          )

        );

      allow delete: if false;
    }

    match /friendInvites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is timestamp;
      allow update: if signedIn()
        && resource.data.senderId != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.recipientId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.senderName == resource.data.senderName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.acceptedAt is number
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'status', 'createdAt', 'expiresAt', 'recipientId', 'acceptedAt']);
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow get: if signedIn() && validFriendCode(code);
      allow list: if false;

      allow create: if signedIn()
        && validFriendCode(code)
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == code;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn()
        && (
          friendshipId.matches('^' + request.auth.uid + '__.*$')
          || friendshipId.matches('^.*__' + request.auth.uid + '$')
          || resource.data.requesterId == request.auth.uid
          || resource.data.addresseeId == request.auth.uid
        );

      allow list: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.addresseeId == request.auth.uid
        );

      allow create: if signedIn()
        && (
          friendshipId == request.resource.data.requesterId + '__' + request.resource.data.addresseeId
          || (
            request.resource.data.status == 'accepted'
            && request.resource.data.inviteId is string
            && friendshipId == 'invite_' + request.resource.data.inviteId
          )
        )
        && request.resource.data.requesterId is string
        && request.resource.data.addresseeId is string
        && request.resource.data.requesterName is string
        && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/users/$(request.resource.data.addresseeId))
        && (
          (request.resource.data.status == 'pending'
            && request.resource.data.requesterId == request.auth.uid
            && request.resource.data.addresseeId != request.auth.uid)
          ||
          (
            request.resource.data.status == 'accepted'
            && request.resource.data.inviteId is string
            && getAfter(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteId)).data.senderId == request.resource.data.requesterId
            && getAfter(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteId)).data.recipientId == request.auth.uid
            && request.resource.data.addresseeId == request.auth.uid
          )
        );

      allow update: if signedIn()
        && (
          (
            resource.data.addresseeId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          ||
          (
            resource.data.requesterId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt', 'requesterName'])
          )
        );

      allow delete: if signedIn()
        && resource.data.status == 'accepted'
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.addresseeId == request.auth.uid
        );
    }

    match /events/{eventId} {
      function validVisibleTo() {
        return request.resource.data.visibleTo is list
          && (
            request.resource.data.visibility != 'selected'
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends is list
              && request.resource.data.visibleTo.hasOnly(
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends
              )
              && request.resource.data.visibleToMap is map
              && request.resource.data.visibleToMap.keys().hasOnly(request.resource.data.visibleTo)
              && request.resource.data.visibleToMap.keys().size() == request.resource.data.visibleTo.size()
            )
          );
      }

      // Migrazione limitata: il proprietario può soltanto aggiungere l'indice
      // ai destinatari già presenti nell'evento, senza cambiare la lista.
      function validVisibleToMigration() {
        return resource.data.visibility == 'selected'
          && resource.data.visibleTo is list
          && request.resource.data.visibleTo == resource.data.visibleTo
          && request.resource.data.visibility == resource.data.visibility
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibleToMap'])
          && request.resource.data.visibleToMap is map
          && request.resource.data.visibleToMap.keys().hasOnly(resource.data.visibleTo)
          && request.resource.data.visibleToMap.keys().size() == resource.data.visibleTo.size();
      }

      function canReadEvent() {
        return signedIn() && (
          resource.data.authorId == request.auth.uid
          ||
          (
            hasAcceptedFriendship(resource.data.authorId)
            && (
              resource.data.visibility == 'all'
              ||
              (
                resource.data.visibility == 'selected'
                && resource.data.visibleToMap is map
                && resource.data.visibleToMap[request.auth.uid] == true
              )
            )
          )
        );
      }

      allow get, list: if canReadEvent();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['all', 'none', 'selected']
        && validVisibleTo();

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['all', 'none', 'selected']
        && (validVisibleTo() || validVisibleToMigration());

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /userPreferences/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
